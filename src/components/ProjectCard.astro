---
import type { ListedProject } from '../projects';

interface Props {
  project: ListedProject;
}

const { project } = Astro.props;
const lang = project.language.toLowerCase().replace('+', 'p');
---

<article class="project card">
  <div class="project-top">
    <span class={`lang lang-${lang}`}>{project.language}</span>
    <span class="status" data-status={project.status}>
      {project.status}
    </span>
  </div>
  <h3>
    <a href={project.repo}>{project.name}</a>
  </h3>
  <p class="project-summary">{project.summary}</p>
  <p class="chips">
    {project.topics.map((topic) => (
      <span class="chip">{topic}</span>
    ))}
  </p>
</article>
