---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PROJECTS } from '../projects';
import { getPublishedPosts } from '../posts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<Base>
  <h1>Rafael Fuentes</h1>
  <p class="lede">
    Software engineer in Málaga. I build production backend systems, data pipelines, AI systems and the
    Kubernetes infrastructure they run on.
  </p>
  <p>
    I'm Tech Lead at Bettergy, where I work across four products and an AI platform: a multi-tenant IoT
    platform on TimescaleDB, a retrieval system serving 18,000+ conversations over regulatory documents,
    and the core energy-certification platform. Before that I did technical due diligence on 300+
    startups and built research data pipelines at the University of Málaga.
  </p>
  <p>
    Here I write about what I'm building outside work: making LLM agents cheaper without making them
    worse, durable execution for distributed systems, and storage engines from the inside.
  </p>

  <h2>Writing</h2>
  <PostList posts={posts} />

  <h2>Current projects</h2>
  <div class="cards">
    {PROJECTS.map((project) => <ProjectCard project={project} />)}
  </div>
</Base>
