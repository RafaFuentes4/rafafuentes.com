---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts } from '../../posts';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const minutes = Math.max(
  1,
  Math.round((post.body ?? '').split(/\s+/).length / 220),
);

const articleUrl = new URL(`/writing/${post.id}/`, Astro.site).href;
const articleImage = new URL(`/og/posts/${post.id}.png`, Astro.site).href;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: articleImage,
  datePublished: post.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Rafael Fuentes',
    url: new URL('/', Astro.site).href,
    sameAs: [SITE.github, SITE.linkedin],
  },
  mainEntityOfPage: articleUrl,
};
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${new URL('/', Astro.site)}#person`,
  name: SITE.title,
  url: new URL('/', Astro.site).href,
  jobTitle: 'Tech Lead at Bettergy',
  sameAs: [SITE.github, SITE.linkedin],
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify([personJsonLd, articleJsonLd])}
  />
  <article class="container narrow post">
    <a class="link-back" href="/writing">
      All writing
    </a>
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <p class="post-lede">{post.data.description}</p>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {fmt.format(post.data.date)}
        </time>
        <span>·</span>
        <span>{minutes} min read</span>
        {post.data.tags.map((tag) => (
          <span class="chip">{tag}</span>
        ))}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
