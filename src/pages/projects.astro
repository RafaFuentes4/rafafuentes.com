---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { LISTED_PROJECTS } from '../projects';
---

<Base
  title="Projects"
  description="Open-source projects on agent efficiency, durable execution and storage engines."
>
  <section class="container page-head">
    <p class="eyebrow">Open source</p>
    <h1>Projects</h1>
    <p class="hero-lede">
      Each project ships with a design doc, reproducible benchmarks and a series
      of write-ups.
    </p>
  </section>
  <section class="container">
    {LISTED_PROJECTS.length > 0 ? (
      <div class="project-grid">
        {LISTED_PROJECTS.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <p class="muted">
        No public repositories yet. Projects appear here once their code is
        open.
      </p>
    )}
  </section>
</Base>
